# AI Shopify Theme Builder — environment variables
# Copy to .env.local for local runs. ALL values are OPTIONAL for the Cut 1
# demo: without keys the built-in template generator runs instead.
# NEVER commit real keys. No InsForge, no Clerk, no real Stripe keys here.

# Gemini (optional) — AI generation ke liye. Na ho to template mode chalta hai.
GEMINI_API_KEY=
# Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Stripe — TEST MODE ONLY. Real keys yahan kabhi mat dalo.
# Demo price $9.99/month sirf test mode ka hai, real price nahi.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Public app URL (deployment par Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
